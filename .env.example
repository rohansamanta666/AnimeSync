# AnimeSync Environment Configuration

# Server Network Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Frontend Dev Server (only needed during separate frontend development)
FRONTEND_PORT=5173

# Database (Async SQLite for zero-cost self-hosting)
DATABASE_URL=sqlite+aiosqlite:///./animesync.db

# Storage Directories
STORAGE_DIR=./storage/videos
TEMP_UPLOAD_DIR=./storage/uploads_temp

# File Upload Constraints
# 4GB max per video file, 5MB chunks (safe for Cloudflare free tunnels & low memory)
MAX_UPLOAD_SIZE_MB=4096
CHUNK_SIZE_BYTES=5242880

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# WebRTC STUN Servers (Free public STUN servers)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN Configuration (Leave blank for default STUN-only P2P)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Sync Engine Drift Thresholds (Seconds)
DRIFT_IGNORE_THRESHOLD=0.25
DRIFT_RATE_ADJUST_THRESHOLD=1.5
DRIFT_HARD_SEEK_THRESHOLD=3.0
